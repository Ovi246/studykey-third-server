# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# Gmail Configuration (for existing notification emails)
GMAIL_USER=your-email@gmail.com
GMAIL_PASS=your-app-password

# SendGrid Configuration (for automated feedback emails)
# Sign up at https://sendgrid.com - Free tier: 100 emails/day
# 1. Create account at https://sendgrid.com
# 2. Go to Settings > API Keys > Create API Key (Full Access)
# 3. Go to Settings > Sender Authentication > Verify a Single Sender
SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxxxxxx
SENDGRID_FROM_EMAIL=noreply@yourdomain.com
SENDGRID_FROM_NAME=Study Key

# Amazon Selling Partner API
SELLING_PARTNER_APP_CLIENT_ID=amzn1.application-oa2-client.xxxxx
SELLING_PARTNER_APP_CLIENT_SECRET=xxxxxxxxxxxxx
REFRESH_TOKEN=Atzr|xxxxxxxxxxxxx

# Cloudinary Configuration
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Admin Authentication
# Single token for all admin access (/admin and /admin/feedback)
ADMIN_SECRET_TOKEN=your-super-secret-admin-token-here

# Vercel Cron Secret
# Generate a strong random string for cron job authentication
CRON_SECRET=your-cron-secret-token-here
